{
    "openapi": "3.0.1",
    "info": {
        "title": "GlazeAudio API",
        "description": "REST API for GlazeAudio \u2013 a platform for reviewing music. Resources are hierarchical: albums \u2192 songs \u2192 reviews.",
        "version": "v1"
    },
    "servers": [
        {
            "url": "http://localhost:5080/"
        }
    ],
