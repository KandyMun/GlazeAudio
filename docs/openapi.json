    "components": {
        "schemas": {
            "AlbumDto": {
                "required": [
                    "id",
                    "title",
                    "artist",
                    "releaseYear",
                    "genre",
                    "coverUrl",
                    "songCount",
                    "reviewCount",
                    "averageRating"
                ],
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "title": {
                        "type": "string"
                    },
                    "artist": {
                        "type": "string"
                    },
                    "releaseYear": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "genre": {
                        "type": "string"
                    },
                    "coverUrl": {
                        "type": "string",
                        "nullable": true
                    },
                    "songCount": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "reviewCount": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "averageRating": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    }
                }
            },
            "AlbumRequest": {
                "required": [
                    "title",
                    "artist",
                    "releaseYear",
                    "genre",
                    "coverUrl"
                ],
                "type": "object",
                "properties": {
                    "title": {
                        "maxLength": 200,
                        "minLength": 1,
                        "type": "string",
                        "nullable": true
                    },
                    "artist": {
                        "maxLength": 200,
                        "minLength": 1,
                        "type": "string",
                        "nullable": true
                    },
                    "releaseYear": {
                        "maximum": 2100,
                        "minimum": 1900,
                        "type": "integer",
                        "format": "int32",
                        "nullable": true
                    },
                    "genre": {
                        "maxLength": 100,
                        "minLength": 1,
                        "type": "string",
                        "nullable": true
                    },
                    "coverUrl": {
                        "maxLength": 500,
                        "minLength": 0,
                        "type": "string",
                        "format": "uri",
                        "nullable": true
                    }
                }
            },
            "HttpValidationProblemDetails": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string",
                        "nullable": true
                    },
                    "title": {
                        "type": "string",
                        "nullable": true
                    },
                    "status": {
                        "type": "integer",
                        "format": "int32",
                        "nullable": true
                    },
                    "detail": {
                        "type": "string",
                        "nullable": true
                    },
                    "instance": {
                        "type": "string",
                        "nullable": true
                    },
                    "errors": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "ProblemDetails": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string",
                        "nullable": true
                    },
                    "title": {
                        "type": "string",
                        "nullable": true
                    },
                    "status": {
                        "type": "integer",
                        "format": "int32",
                        "nullable": true
                    },
                    "detail": {
                        "type": "string",
                        "nullable": true
                    },
                    "instance": {
                        "type": "string",
                        "nullable": true
                    }
                }
            },
            "ReviewDto": {
                "required": [
                    "id",
                    "songId",
                    "authorName",
                    "lyricsRating",
                    "melodyRating",
                    "moodRating",
                    "expressivenessRating",
                    "overallRating",
                    "comment",
                    "createdAt",
                    "updatedAt"
                ],
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "songId": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "authorName": {
                        "type": "string"
                    },
                    "lyricsRating": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "melodyRating": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "moodRating": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "expressivenessRating": {
                        "type": "integer",
                        "format": "int32"
