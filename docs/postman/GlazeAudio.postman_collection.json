              "raw": "{\n  \"title\": \"In Rainbows\",\n  \"artist\": \"Radiohead\",\n  \"releaseYear\": 2007,\n  \"genre\": \"Art Rock\",\n  \"coverUrl\": \"https://example.com/covers/in-rainbows.jpg\"\n}",
