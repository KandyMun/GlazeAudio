                  "pm.test(\"Status 404 Not Found\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Content-Type is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.match(/application\\/(problem\\+)?json/));",
