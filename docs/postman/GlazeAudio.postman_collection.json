{
  "info": {
    "_postman_id": "ecf14979-9518-4ef5-b157-bb7292fb0fab",
    "name": "GlazeAudio API",
    "description": "Demonstrates all 15 GlazeAudio API methods (5 per resource: albums → songs → reviews) and the 400 / 404 / 422 / 201 / 204 cases.\n\nRun the whole collection with the Runner (or `newman run`). It creates its own album, song and review, then deletes them, so it can be re-run any number of times.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Albums",
      "item": [
        {
          "name": "GET all albums",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.match(/application\\/(problem\\+)?json/));",
                  "pm.test(\"Returns seeded albums\", () => { const b = pm.response.json(); pm.expect(b).to.be.an(\"array\").that.is.not.empty; pm.expect(b[0]).to.have.keys(\"id\",\"title\",\"artist\",\"releaseYear\",\"genre\",\"coverUrl\",\"songCount\",\"reviewCount\",\"averageRating\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/albums",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "albums"
              ]
            }
          }
        },
        {
          "name": "POST create album",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Content-Type is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.match(/application\\/(problem\\+)?json/));",
                  "const b = pm.response.json();",
                  "pm.test(\"Location header points to new album\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/api/albums/\" + b.id));",
                  "pm.test(\"Body echoes the album\", () => pm.expect(b.title).to.eql(\"In Rainbows\"));",
                  "pm.collectionVariables.set(\"albumId\", b.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/albums",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "albums"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"In Rainbows\",\n  \"artist\": \"Radiohead\",\n  \"releaseYear\": 2007,\n  \"genre\": \"Alternative Rock\",\n  \"coverUrl\": \"https://example.com/covers/in-rainbows.jpg\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "GET one album",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.match(/application\\/(problem\\+)?json/));",
                  "pm.test(\"Correct album\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"albumId\"))));"
                ]
              }
            }
          ],
          "request": {
